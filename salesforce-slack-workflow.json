{
  "name": "Salesforce-Slack営業マーケ連携",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "trigger-node",
      "name": "30分ごとにチェック",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "lead",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "options": {
          "conditionsUi": {
            "conditionValues": [
              {
                "field": "Status",
                "operation": "equals",
                "value": "New"
              },
              {
                "field": "CreatedDate",
                "operation": "greaterThan",
                "value": "={{$now.minus(1, 'day').toISO()}}"
              }
            ]
          }
        }
      },
      "id": "salesforce-new-leads",
      "name": "新規リード取得",
      "type": "n8n-nodes-base.salesforce",
      "typeVersion": 1,
      "position": [450, 200],
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "1",
          "name": "Salesforce account"
        }
      }
    },
    {
      "parameters": {
        "resource": "opportunity",
        "operation": "getAll",
        "returnAll": false,
        "limit": 20,
        "options": {
          "conditionsUi": {
            "conditionValues": [
              {
                "field": "StageName",
                "operation": "equals",
                "value": "Closed Won"
              },
              {
                "field": "CloseDate",
                "operation": "equals",
                "value": "={{$today.toFormat('yyyy-MM-dd')}}"
              }
            ]
          }
        }
      },
      "id": "salesforce-won-deals",
      "name": "本日成約案件取得",
      "type": "n8n-nodes-base.salesforce",
      "typeVersion": 1,
      "position": [450, 400],
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "1",
          "name": "Salesforce account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.length}}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-new-leads",
      "name": "新規リードあり？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 200]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.length}}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-won-deals",
      "name": "成約案件あり？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 400]
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.all();\nlet summary = {\n  total: leads.length,\n  bySource: {},\n  byIndustry: {},\n  highValue: [],\n  details: []\n};\n\nfor (const lead of leads) {\n  const data = lead.json;\n  \n  // ソース別集計\n  const source = data.LeadSource || 'Unknown';\n  summary.bySource[source] = (summary.bySource[source] || 0) + 1;\n  \n  // 業界別集計\n  const industry = data.Industry || 'Unknown';\n  summary.byIndustry[industry] = (summary.byIndustry[industry] || 0) + 1;\n  \n  // 重要リード抽出（例：従業員数が多い）\n  if (data.NumberOfEmployees > 100) {\n    summary.highValue.push({\n      name: data.Company,\n      employees: data.NumberOfEmployees,\n      title: data.Title\n    });\n  }\n  \n  // 詳細情報\n  summary.details.push({\n    会社名: data.Company,\n    担当者: data.Name,\n    メール: data.Email,\n    電話: data.Phone,\n    リードソース: data.LeadSource,\n    業界: data.Industry,\n    従業員数: data.NumberOfEmployees\n  });\n}\n\nreturn summary;"
      },
      "id": "process-leads",
      "name": "リードデータ集計",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "jsCode": "const deals = $input.all();\nlet summary = {\n  total: deals.length,\n  totalAmount: 0,\n  byStage: {},\n  byOwner: {},\n  topDeals: [],\n  details: []\n};\n\nfor (const deal of deals) {\n  const data = deal.json;\n  \n  // 合計金額\n  summary.totalAmount += data.Amount || 0;\n  \n  // オーナー別集計\n  const owner = data.Owner?.Name || 'Unknown';\n  if (!summary.byOwner[owner]) {\n    summary.byOwner[owner] = {\n      count: 0,\n      amount: 0\n    };\n  }\n  summary.byOwner[owner].count++;\n  summary.byOwner[owner].amount += data.Amount || 0;\n  \n  // TOP案件\n  if (data.Amount > 1000000) {\n    summary.topDeals.push({\n      name: data.Name,\n      amount: data.Amount,\n      account: data.Account?.Name\n    });\n  }\n  \n  // 詳細情報\n  summary.details.push({\n    案件名: data.Name,\n    顧客名: data.Account?.Name,\n    金額: data.Amount,\n    営業担当: owner,\n    成約日: data.CloseDate\n  });\n}\n\nreturn summary;"
      },
      "id": "process-deals",
      "name": "成約データ集計",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 400]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "marketing-sales",
          "mode": "name"
        },
        "messageType": "block",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "header",
              "text": {
                "type": "plain_text",
                "text": "📊 新規リード速報",
                "emoji": true
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*本日の新規リード: {{$json.total}}件*"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*リードソース別:*\\n{{Object.entries($json.bySource).map(([k,v]) => `• ${k}: ${v}件`).join('\\n')}}"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*業界別:*\\n{{Object.entries($json.byIndustry).map(([k,v]) => `• ${k}: ${v}件`).join('\\n')}}"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "{{$json.highValue.length > 0 ? '*🔥 注目リード（従業員100名以上）:*\\n' + $json.highValue.map(l => `• ${l.name} (${l.employees}名)`).join('\\n') : ''}}"
              }
            },
            {
              "type": "actions",
              "elements": [
                {
                  "type": "button",
                  "text": {
                    "type": "plain_text",
                    "text": "Salesforceで詳細を見る",
                    "emoji": true
                  },
                  "url": "https://your-instance.salesforce.com/lightning/o/Lead/list"
                }
              ]
            }
          ]
        },
        "options": {
          "thread_ts": {
            "ts": ""
          }
        }
      },
      "id": "slack-notify-leads",
      "name": "Slack通知（リード）",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1050, 200],
      "credentials": {
        "slackOAuth2Api": {
          "id": "2",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "sales-team",
          "mode": "name"
        },
        "messageType": "block",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "header",
              "text": {
                "type": "plain_text",
                "text": "🎉 本日の成約速報",
                "emoji": true
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*成約件数: {{$json.total}}件*\\n*合計金額: ¥{{$json.totalAmount.toLocaleString()}}*"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*営業担当別実績:*\\n{{Object.entries($json.byOwner).map(([k,v]) => `• ${k}: ${v.count}件 (¥${v.amount.toLocaleString()})`).join('\\n')}}"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "{{$json.topDeals.length > 0 ? '*🏆 大型案件（100万円以上）:*\\n' + $json.topDeals.map(d => `• ${d.name} - ${d.account}: ¥${d.amount.toLocaleString()}`).join('\\n') : ''}}"
              }
            },
            {
              "type": "divider"
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "_素晴らしい成果です！チーム全員の努力の賜物ですね！_ 🚀"
              }
            }
          ]
        }
      },
      "id": "slack-notify-deals",
      "name": "Slack通知（成約）",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1050, 400],
      "credentials": {
        "slackOAuth2Api": {
          "id": "2",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "create",
        "priority": "High",
        "status": "Not Started",
        "subject": "フォローアップ: {{$json.details[0].会社名}}",
        "description": "新規リード {{$json.total}}件が登録されました。\\n\\n優先度高のリード:\\n{{$json.highValue.map(l => `- ${l.name}`).join('\\n')}}\\n\\n24時間以内に初回コンタクトをお願いします。",
        "activityDate": "={{$now.plus(1, 'day').toISO()}}",
        "additionalFields": {
          "whoId": "={{$json.details[0].Id}}"
        }
      },
      "id": "create-followup-task",
      "name": "フォローアップタスク作成",
      "type": "n8n-nodes-base.salesforce",
      "typeVersion": 1,
      "position": [1050, 100],
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "1",
          "name": "Salesforce account"
        }
      }
    }
  ],
